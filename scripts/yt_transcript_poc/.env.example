# YT Transcript POC — local secrets (DO NOT COMMIT).
#
# Copy this file to `.env` (same directory) and fill in your key.
# `.env` is gitignored — never committed. transcribe.py auto-loads it.
#
# Get a key:
#   1. https://aistudio.google.com/app/apikey
#   2. Sign in -> Create API key -> pick/create a Cloud project.
#   3. Enable billing on that Cloud project (free tier throttles batch
#      runs heavily; the 75 × 35-min Treantmonk batch is ~$3–8 total).
#   4. Paste the key value into the line below (no quotes needed, no
#      trailing spaces).
#
# Either GEMINI_API_KEY or GOOGLE_API_KEY works (transcribe.py reads
# both). Use whichever you set.

GEMINI_API_KEY=

# Optional model overrides (defaults are fine):
# YT_POC_ASR_MODEL=gemini-2.5-flash-lite
# YT_POC_LLM_MODEL=gemini-2.5-flash
