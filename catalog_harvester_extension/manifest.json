{
    "manifest_version": 3,
    "name": "Arcane Incursion - Catalog Harvester",
    "version": "1.4",
    "description": "Auto-harvest DMs Guild, DriveThruRPG & Amazon best-seller data weekly.",
    "permissions": [
        "alarms",
        "storage",
        "tabs",
        "scripting"
    ],
    "host_permissions": [
        "*://*.dmsguild.com/*",
        "*://*.drivethrurpg.com/*",
        "*://*.amazon.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Arcane Incursion"
    }
}
