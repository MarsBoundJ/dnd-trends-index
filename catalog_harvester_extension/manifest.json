{
    "manifest_version": 3,
    "name": "Arcane Incursion - Catalog Harvester",
    "version": "1.6",
    "description": "Weekly harvest: DMs Guild, DriveThruRPG, Amazon, Kickstarter & BackerKit.",
    "permissions": [
        "alarms",
        "storage",
        "tabs",
        "scripting"
    ],
    "host_permissions": [
        "*://*.dmsguild.com/*",
        "*://*.drivethrurpg.com/*",
        "*://*.amazon.com/*",
        "*://*.kickstarter.com/*",
        "*://*.backerkit.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Arcane Incursion"
    }
}
