# Webshare residential proxy — authenticated rotating endpoint on the STANDARD port 80.
# Do NOT use the IP-auth endpoint on port 9999 or any SOCKS port (1080/9999):
# requests to non-standard ports trip Webshare's abuse/verification checks.
#
# Single full URL (used by most scripts via os.environ["PROXY_URL"]):
PROXY_URL=http://<username>-rotate:<password>@p.webshare.io:80

# Building blocks (used by cloud_functions/related_queries_discovery/main.py):
WEBSHARE_PROXY_HOST=p.webshare.io
WEBSHARE_PROXY_PORT=80
WEBSHARE_PROXY_USER=<username>
WEBSHARE_PROXY_PASS=<password>

# Quick connectivity test (replace placeholders):
#   curl -x "http://<username>-rotate:<password>@p.webshare.io:80" https://api.ipify.org
